<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="96"
    android:viewportHeight="96">
    
    <!-- Background rounded square with soft gradient -->
    <path
        android:pathData="M20,6 C12.268,6 6,12.268 6,20 L6,76 C6,83.732 12.268,90 20,90 L76,90 C83.732,90 90,83.732 90,76 L90,20 C90,12.268 83.732,6 76,6 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="6"
                android:startY="6"
                android:endX="90"
                android:endY="90"
                android:type="linear">
                <item android:offset="0.0" android:color="#1B4D3E" />
                <item android:offset="1.0" android:color="#0B2B20" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Outer Threshold Arch (Eşik Kemeri) -->
    <path
        android:pathData="M28,68 L28,42 C28,30.954 36.954,22 48,22 C59.046,22 68,30.954 68,42 L68,68"
        android:strokeWidth="5"
        android:strokeColor="#74C69D"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- Inner Threshold Step / Baseline -->
    <path
        android:pathData="M22,70 L74,70"
        android:strokeWidth="5"
        android:strokeColor="#D8F3DC"
        android:strokeLineCap="round" />

    <!-- Mindfulness Balance Sphere / Rising Sun -->
    <path
        android:pathData="M48,46 m-9,0 a9,9 0 1,0 18,0 a9,9 0 1,0 -18,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="39"
                android:startY="37"
                android:endX="57"
                android:endY="55"
                android:type="linear">
                <item android:offset="0.0" android:color="#FBBF24" />
                <item android:offset="1.0" android:color="#D97706" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
